{
  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "Bundler",
    "types": ["bun"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
